APP_NAME=dejavoo

FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3306

MYSQL_DATABASE=dejavoo
MYSQL_USER=dejavoo
MYSQL_PASSWORD=dejavoo
MYSQL_ROOT_PASSWORD=root

NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_INTERNAL_URL=http://backend:8000

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
