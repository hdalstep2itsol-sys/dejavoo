APP_NAME=dejavoo
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3306

MYSQL_DATABASE=dejavoo
MYSQL_USER=dejavoo
MYSQL_PASSWORD=dejavoo
MYSQL_ROOT_PASSWORD=root

NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_INTERNAL_URL=http://backend:8000

# The Docker backend and queue worker both read these values. Keep `log` for
# development; use `gmail-api` or optional `smtp` only in production runtime.
QUEUE_CONNECTION=database
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Dejavoo Logistics Hub"

# Gmail API delivery over HTTPS. Set MAIL_MAILER=gmail-api and set
# MAIL_FROM_ADDRESS to the same mailbox as GMAIL_SENDER_EMAIL in production.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required when running the deterministic demo seeder. Use 12+ characters.
DEV_TEST_USER_PASSWORD=

# iPOSpays FEED stays fail-closed until confirmed provider profiles are implemented.
IPOSPAYS_FEED_ENABLED=false
IPOSPAYS_FEED_AUTH_MODE=hmac
IPOSPAYS_FEED_BASIC_USERNAME=
IPOSPAYS_FEED_BASIC_PASSWORD=
IPOSPAYS_FEED_DIAGNOSTIC_MODE=false
IPOSPAYS_FEED_AUTH_DIAGNOSTICS=false
IPOSPAYS_FEED_HMAC_SECRET=
# Available after controlled provider retest: dejavoo_feed_v1
IPOSPAYS_FEED_HMAC_PROFILE=unfinalized
IPOSPAYS_FEED_MAPPING_PROFILE=unfinalized
IPOSPAYS_FEED_TIMEZONE=America/New_York
IPOSPAYS_FEED_MAX_PAYLOAD_BYTES=262144
IPOSPAYS_FEED_ALERT_EMAIL=
# Alert after this many unexpected failures inside one rate-limit window.
IPOSPAYS_FEED_FAILURE_ALERT_THRESHOLD=3
IPOSPAYS_FEED_FAILURE_ALERT_WINDOW_SECONDS=900
# Dashboard lookback window for the recent FEED failure count.
IPOSPAYS_FEED_FAILURE_RECENT_SECONDS=86400
